  "views": {
    "review_category_months": {
      "columns": {
        "year": {
          "name": "year",
          "type": "integer",
          "primaryKey": false,
          "notNull": false,
          "autoincrement": false
        },
        "month": {
          "name": "month",
          "type": "integer",
          "primaryKey": false,
