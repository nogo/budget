          "autoincrement": false
        },
        "income": {
          "name": "income",
          "type": "real",
          "primaryKey": false,
          "notNull": false,
          "autoincrement": false
        },
        "expense": {
          "name": "expense",
          "type": "real",
          "primaryKey": false,
          "notNull": false,
          "autoincrement": false
        },
        "total": {
          "name": "total",
          "type": "real",
          "primaryKey": false,
          "notNull": false,
          "autoincrement": false
        }
      },
      "name": "review_category_months",
      "isExisting": false,
      "definition": "\nSELECT\n  CAST(strftime('%Y', date, 'unixepoch') as DECIMAL) AS year,\n  CAST(strftime('%m', date, 'unixepoch') as DECIMAL) AS month,\n  categories.name AS category_name,\n  SUM(CASE WHEN type = 'income' THEN amount ELSE 0 END) AS income,\n  SUM(CASE WHEN type = 'expense' THEN amount ELSE 0 END) AS expense,\n  SUM(CASE WHEN type = 'income' THEN amount ELSE 0 END) - SUM(CASE WHEN type = 'expense' THEN amount ELSE 0 END) AS total\nFROM transactions\nLEFT JOIN categories ON transactions.category_id = categories.id\nGROUP BY year, month, category_id\nORDER BY year DESC, month DESC\n"
    },
